{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webapp",
  "compatibility_date": "2025-12-28",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "webapp-production",
      "database_id": "local-dev-database"
    }
  ],
  // Variables d'environnement (définies dans .dev.vars pour le dev local)
  // Pour la production, utiliser: wrangler pages secret put RESEND_API_KEY
  "vars": {
    "FROM_EMAIL": "noreply@academie-lumiere.fr",
    "ADMIN_EMAIL": "admin@academie-lumiere.fr"
  }
}